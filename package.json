{
  "name": "@sanity/webhook",
  "version": "4.0.4",
  "description": "Toolkit for dealing with GROQ-powered webhooks delivered by Sanity.io",
  "keywords": [
    "webhook",
    "webhooks",
    "sanity-io",
    "sanity",
    "verify",
    "validate"
  ],
  "homepage": "https://github.com/sanity-io/webhook-toolkit#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/webhook-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/webhook-toolkit.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkg build --strict --check --clean",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish",
    "test": "vitest"
  },
  "browserslist": [
    "last 1 chrome version",
    "maintained node versions"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@sanity/pkg-utils": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "body-parser": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "express": "^4.22.1",
    "ls-engines": "^0.10.1",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
